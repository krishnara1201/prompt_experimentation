# Copy to .env and fill in whichever keys you have. Arms whose key is
# missing will print FAILED in the demo output instead of crashing it.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google AI Studio key — used by the `gemini-flash` arm via Gemini's
# OpenAI-compatible endpoint (https://generativelanguage.googleapis.com/v1beta/openai).
GEMINI_API_KEY=

# Optional: overrides the base URL of every arms.yaml arm/judge that points
# at a local Ollama (localhost or 127.0.0.1 on :11434), for when this process
# can't reach Ollama on `localhost` (remote Ollama, etc.) — leaving arms.yaml
# on `localhost` for everyone else. Other providers on the same adapter
# (OpenAI, Gemini, …) are matched by host and left untouched. For the Docker
# flow set this in the repo-root .env instead (compose passes it through).
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prompt_experimentation
REDIS_URL=redis://localhost:6379/0
REDIS_BACKEND_URL=redis://localhost:6379/1

# Optional: base URL the `pe` CLI talks to (default http://localhost:8000).
# PE_API_URL=http://localhost:8000
